---
import { UI } from "../lib/ui";
import { sitePath } from "../lib/posts";

const here = Astro.url.pathname;

const links = [
  { href: sitePath("blog"), label: UI.nav.posts },
  { href: sitePath("projects"), label: UI.nav.projects },
  { href: sitePath("domains"), label: UI.nav.domains },
  { href: sitePath("topics"), label: UI.nav.topics },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="site-title" href={sitePath()}>{UI.siteTitle}</a>
    <nav class="site-nav">
      {
        links.map((l) => (
          <a href={l.href} aria-current={here.startsWith(l.href) ? "true" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
