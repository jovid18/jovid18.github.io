---
import type { Post } from "../lib/posts";
import { formatDate, localePath } from "../lib/posts";
import { DOMAIN_LABELS, type Lang } from "../i18n/taxonomy";

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { data } = post;
---

<li>
  <h2 class="post-card-title">
    <a href={localePath(lang, `blog/${post.slug}`)}>{data.title}</a>
  </h2>
  <p class="post-card-desc">{data.description}</p>
  <div class="meta">
    <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt, lang)}</time>
    <ul class="badges">
      <li>
        <a class="badge" data-kind="domain" href={localePath(lang, `domains/${data.domain}`)}>
          {DOMAIN_LABELS[lang][data.domain]}
        </a>
      </li>
      {
        data.topics.map((topic) => (
          <li>
            <a class="badge" href={localePath(lang, `topics/${topic}`)}>
              {topic}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</li>
