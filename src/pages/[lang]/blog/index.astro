---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import { LANGS, type Lang } from "../../../i18n/taxonomy";
import { t } from "../../../i18n/ui";
import { getPosts, localePath } from "../../../lib/posts";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const ui = t(lang);
const posts = await getPosts(lang);

const alternates = Object.fromEntries(
  LANGS.map((l) => [l, localePath(l, "blog")]),
) as Record<Lang, string>;
---

<BaseLayout lang={lang} title={ui.allPosts} alternates={alternates}>
  <h1>{ui.allPosts}</h1>
  <p class="page-lead">{ui.postCount(posts.length)}</p>
  {
    posts.length === 0 ? (
      <p class="notice">{ui.noPosts}</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard post={post} lang={lang} />
        ))}
      </ul>
    )
  }
</BaseLayout>
