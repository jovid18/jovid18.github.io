---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { UI } from "../../lib/ui";
import { countByTopic, sitePath } from "../../lib/posts";

const topics = await countByTopic();
---

<BaseLayout title={UI.nav.topics}>
  <h1>{UI.nav.topics}</h1>
  {
    topics.length === 0 ? (
      <p class="notice">{UI.noPosts}</p>
    ) : (
      <ul class="badges" style="margin-top:1.5rem">
        {topics.map(([topic, count]) => (
          <li>
            <a class="badge" href={sitePath(`topics/${topic}`)}>
              {topic} · {count}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
