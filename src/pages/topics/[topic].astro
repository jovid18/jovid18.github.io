---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { UI } from "../../lib/ui";
import { getPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const topics = new Set((await getPosts()).flatMap((p) => p.data.topics));
  return [...topics].map((topic) => ({ params: { topic } }));
}

const topic = Astro.params.topic!;
const posts = (await getPosts()).filter((p) => p.data.topics.includes(topic));
---

<BaseLayout title={topic}>
  <h1>{topic}</h1>
  <p class="page-lead">{UI.postCount(posts.length)}</p>
  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>
