---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { UI } from "../lib/ui";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 10);
---

<BaseLayout title={UI.siteTitle}>
  <h1>{UI.siteTitle}</h1>
  <p class="page-lead">{UI.siteDescription}</p>

  <h2>{UI.latestPosts}</h2>
  {
    posts.length === 0 ? (
      <p class="notice">{UI.noPosts}</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </ul>
    )
  }
</BaseLayout>
