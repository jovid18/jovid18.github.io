---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { DOMAINS, DOMAIN_LABELS, type Domain } from "../../lib/taxonomy";
import { UI } from "../../lib/ui";
import { getPosts } from "../../lib/posts";

export function getStaticPaths() {
  return DOMAINS.map((domain) => ({ params: { domain } }));
}

const domain = Astro.params.domain as Domain;
const label = DOMAIN_LABELS[domain];
const posts = (await getPosts()).filter((p) => p.data.domain === domain);
---

<BaseLayout title={label}>
  <h1>{label}</h1>
  <p class="page-lead">{UI.postCount(posts.length)}</p>
  {
    posts.length === 0 ? (
      <p class="notice">{UI.noPosts}</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </ul>
    )
  }
</BaseLayout>
