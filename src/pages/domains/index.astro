---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DOMAINS, DOMAIN_LABELS } from "../../lib/taxonomy";
import { UI } from "../../lib/ui";
import { countByDomain, sitePath } from "../../lib/posts";

const counts = await countByDomain();
---

<BaseLayout title={UI.nav.domains}>
  <h1>{UI.nav.domains}</h1>
  <ul class="axis-grid">
    {
      DOMAINS.map((domain) => (
        <li>
          <a class="axis-card" href={sitePath(`domains/${domain}`)}>
            <strong>{DOMAIN_LABELS[domain]}</strong>
            <small>{UI.postCount(counts.get(domain) ?? 0)}</small>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
