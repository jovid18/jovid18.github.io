---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PROJECT_STATUS_LABELS } from "../../lib/taxonomy";
import { UI } from "../../lib/ui";
import { countByProject, sitePath } from "../../lib/posts";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);
const counts = await countByProject();
---

<BaseLayout title={UI.nav.projects}>
  <h1>{UI.nav.projects}</h1>
  <ul class="axis-grid">
    {
      projects.map((project) => (
        <li>
          <a class="axis-card" href={sitePath(`projects/${project.id}`)}>
            <strong>{project.data.name}</strong>
            <small>
              {PROJECT_STATUS_LABELS[project.data.status]} ·{" "}
              {UI.postCount(counts.get(project.id) ?? 0)}
            </small>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
