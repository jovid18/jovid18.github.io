---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { UI } from "../../lib/ui";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<BaseLayout title={UI.allPosts}>
  <h1>{UI.allPosts}</h1>
  <p class="page-lead">{UI.postCount(posts.length)}</p>
  {
    posts.length === 0 ? (
      <p class="notice">{UI.noPosts}</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </ul>
    )
  }
</BaseLayout>
