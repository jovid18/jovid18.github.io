---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DOMAIN_LABELS, POST_TYPE_LABELS } from "../../lib/taxonomy";
import { UI } from "../../lib/ui";
import { formatDate, getPosts, sitePath, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { data } = post;

const project = data.project ? await getEntry(data.project) : undefined;
---

<BaseLayout title={data.title} description={data.description}>
  <article>
    <h1>{data.title}</h1>
    <p class="page-lead">{data.description}</p>

    <div class="meta">
      <span>
        {UI.publishedAt}
        <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
      </span>
      {
        data.updatedAt && (
          <span>
            {UI.updatedAt}
            <time datetime={data.updatedAt.toISOString()}>{formatDate(data.updatedAt)}</time>
          </span>
        )
      }
      <span>{POST_TYPE_LABELS[data.type]}</span>
    </div>

    <div class="meta" style="margin-top:0.75rem">
      <ul class="badges">
        <li>
          <a class="badge" data-kind="domain" href={sitePath(`domains/${data.domain}`)}>
            {DOMAIN_LABELS[data.domain]}
          </a>
        </li>
        {
          project && (
            <li>
              <a class="badge" href={sitePath(`projects/${project.id}`)}>
                {project.data.name}
              </a>
            </li>
          )
        }
        {
          data.topics.map((topic) => (
            <li>
              <a class="badge" href={sitePath(`topics/${topic}`)}>
                {topic}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
